-- ============================================
-- Convenience Functions for Direct Execution
-- ============================================

-- These functions allow direct execution without creating a full command table
-- Useful for reflex layer and other internal SCAR code

function Build(engineerId, buildingType, x, y, z)
{
    return ExecuteBuildCommand({
        command = "BUILD",
        engineer_id = engineerId,
        building_type = buildingType,
        position = {x, y, z}
    })
}

function Capture(squadId, pointId)
{
    return ExecuteCaptureCommand({
        command = "CAPTURE",
        squad_id = squadId,
        point_id = pointId
    })
}

function AttackMove(squadId, x, y, z)
{
    return ExecuteAttackMoveCommand({
        command = "ATTACK_MOVE",
        squad_id = squadId,
        position = {x, y, z}
    })
}

function SetPosture(squadId, posture)
{
    return ExecuteSetPostureCommand({
        command = "SET_POSTURE",
        squad_id = squadId,
        posture = posture
    })
}

function Produce(buildingId, unitType)
{
    return ExecuteProduceCommand({
        command = "PRODUCE",
        building_id = buildingId,
        unit_type = unitType
    })
}

function Retreat(squadId)
{
    return ExecuteRetreatCommand({
        command = "RETREAT",
        squad_id = squadId
    })
}

function Stop(squadId)
{
    return ExecuteStopCommand({
        command = "STOP",
        squad_id = squadId
    })
}

function Hold(squadId)
{
    return ExecuteHoldCommand({
        command = "HOLD",
        squad_id = squadId
    })
}

-- ============================================
-- Entity Lookup Functions
-- ============================================

function GetSquadById(squadId)
{
    local player = GetLocalPlayer()
    if (!IsValidPlayer(player)) then
        return null
    end
    
    local squads = player:GetSquads()
    if (squads == null) then
        return null
    end
    
    for i = 1, #squads do
        local squad = squads[i]
        if (squad ~= null and squad:IsValid() and squad:GetId() == squadId) then
            return squad
        end
    end
    
    return null
}

function GetCapturePointById(cpId)
{
    local map = ebx:Game.GetMap()
    if (map == null) then
        return null
    end
    
    local cps = map:GetCapturePoints()
    if (cps == null) then
        return null
    end
    
    for i = 1, #cps do
        local cp = cps[i]
        if (cp ~= null and cp:GetId() == cpId) then
            return cp
        end
    end
    
    return null
}

function GetBuildingById(buildingId)
{
    local player = GetLocalPlayer()
    if (!IsValidPlayer(player)) then
        return null
    end
    
    local buildings = player:GetBuildings()
    if (buildings == null) then
        return null
    end
    
    for i = 1, #buildings do
        local building = buildings[i]
        if (building ~= null and building:IsValid() and building:GetId() == buildingId) then
            return building
        end
    end
    
    return null
}

-- ============================================
-- Statistics Tracking
-- ============================================

function GetCommandStatistics()
{
    return {
        total_commands = commandStats.total_commands,
        successful = commandStats.successful,
        failed = commandStats.failed,
        success_rate = commandStats.total_commands > 0 
            and (commandStats.successful / commandStats.total_commands) or 0,
        by_type = commandStats.by_type,
        average_execution_time = CalculateAverageExecutionTime()
    }
}

function RecordCommandAttempt(commandType)
{
    commandStats.total_commands = commandStats.total_commands + 1
    commandStats.by_type[commandType] = (commandStats.by_type[commandType] or 0) + 1
    commandStats.last_execution_time = GetTimestamp()
end

function RecordCommandSuccess(commandType)
{
    commandStats.successful = commandStats.successful + 1
end

function RecordCommandFailure(commandType)
{
    commandStats.failed = commandStats.failed + 1
end

function RecordExecutionTime(commandType, time)
{
    if (commandStats.execution_times[commandType] == null) then
        commandStats.execution_times[commandType] = {}
    end
    
    table.insert(commandStats.execution_times[commandType], time)
    
    -- Keep only last 100 executions to prevent memory bloat
    if (#commandStats.execution_times[commandType] > 100) then
        table.remove(commandStats.execution_times[commandType], 1)
    end
end

function CalculateAverageExecutionTime()
{
    local total = 0
    local count = 0
    
    for commandType, times in pairs(commandStats.execution_times) do
        for i = 1, #times do
            total = total + times[i]
            count = count + 1
        end
    end
    
    return count > 0 and (total / count) or 0
end

function GetExecutionTimes(commandType)
{
    return commandStats.execution_times[commandType] or {}
end

-- ============================================
-- Pending Command Tracking
-- ============================================

function HasPendingCommands(entityKey, commandType)
{
    local entityCommands = pendingCommands[entityKey]
    if (entityCommands == null) then
        return false
    end
    
    local count = entityCommands[commandType] or 0
    return count >= COMMAND_QUEUE_MAX_SIZE
end

function TrackPendingCommand(entityKey, commandType)
{
    if (pendingCommands[entityKey] == null) then
        pendingCommands[entityKey] = {}
    end
    
    pendingCommands[entityKey][commandType] = (pendingCommands[entityKey][commandType] or 0) + 1
end

function ClearPendingCommand(entityKey, commandType)
{
    if (pendingCommands[entityKey] ~= null) then
        pendingCommands[entityKey][commandType] = (pendingCommands[entityKey][commandType] or 1) - 1
        
        -- Clean up if zero
        if (pendingCommands[entityKey][commandType] <= 0) then
            pendingCommands[entityKey][commandType] = nil
        end
        
        -- Clean up entity if no commands
        if (next(pendingCommands[entityKey]) == nil) then
            pendingCommands[entityKey] = nil
        end
    end
}

function ClearAllPendingCommands()
{
    pendingCommands = {}
end

-- ============================================
-- Utility Functions
-- ============================================

function GetLocalPlayer()
{
    if (ebx ~= null and ebx.Game ~= null and ebx.Game.GetLocalPlayer ~= null) then
        return ebx:Game.GetLocalPlayer()
    end
    return nil
end

function IsValidPlayer(player)
{
    if (player == null) then
        return false
    end
    
    if (player.IsValid ~= null) then
        return player:IsValid()
    end
    
    return true
end

function GetTimestamp()
{
    if (ebx ~= null and ebx.System ~= null and ebx.System.GetTime ~= null) then
        return ebx:System.GetTime()
    end
    
    -- Fallback: use os.time() if available
    if (os ~= null and os.time ~= null) then
        return os.time()
    end
    
    return 0
end

