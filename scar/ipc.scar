// ============================================
// CoH1 × Mistral AI Mod - IPC Communication
// ============================================
//
// Handles file-based IPC between SCAR and Python orchestrator.
// Writes game state to file for Python to read.
// Reads commands from file to execute in game.
//
// Author: Generated via planner skill
// Version: 0.2.0
// Date: 2026-10-04
//
// Documentation: https://scardoc.coh.fi/
// ============================================

// ============================================
// Configuration - Matches Python config
// ============================================

constant IPC_STATE_FILE = "coh1ai_state.json"
constant IPC_COMMAND_FILE = "coh1ai_commands.json"
constant IPC_LOCK_FILE = "coh1ai_lock.tmp"
constant DATA_DIR = "coh1ai_data/"

constant STATE_WRITE_INTERVAL = 1.0  // Seconds between state writes
constant COMMAND_READ_INTERVAL = 0.1  // Seconds between command reads

// ============================================
// File I/O Utilities
// ============================================

function EnsureDirectoryExists(path)
{
    -- SCAR file system access
    local fullPath = GetFullPath(path)
    
    -- Check if directory exists, create if not
    if (!DoesFileExist(fullPath)) {
        CreateDirectory(fullPath)
    }
end

function GetFullPath(filename)
{
    return DATA_DIR .. filename
}

function WriteFile(filename, content)
{
    local fullPath = GetFullPath(filename)
    EnsureDirectoryExists(DATA_DIR)
    
    local file = open(fullPath, "w")
    if (file ~= null) {
        file:write(content)
        file:close()
        return true
    }
    
    Log("ERROR: Failed to write file: " .. fullPath)
    return false
}

function ReadFile(filename)
{
    local fullPath = GetFullPath(filename)
    
    if (!DoesFileExist(fullPath)) {
        return null
    }
    
    local file = open(fullPath, "r")
    if (file ~= null) {
        local content = file:read("*a")
        file:close()
        return content
    }
    
    Log("ERROR: Failed to read file: " .. fullPath)
    return null
}

function DeleteFile(filename)
{
    local fullPath = GetFullPath(filename)
    
    if (DoesFileExist(fullPath)) {
        os.remove(fullPath)
        return true
    }
    
    return false
}

function FileExists(filename)
{
    local fullPath = GetFullPath(filename)
    return DoesFileExist(fullPath)
}

// Simple file locking mechanism
function AcquireLock(timeout)
{
    local lockPath = GetFullPath(IPC_LOCK_FILE)
    local startTime = GetTimestamp()
    
    while (GetTimestamp() - startTime < (timeout or 1.0)) do
        if (!FileExists(IPC_LOCK_FILE)) then
            -- Try to create lock file
            if (WriteFile(IPC_LOCK_FILE, "locked")) then
                return true
            end
        end
        
        -- Wait a bit before retrying
        Sleep(0.01)
    end
    
    return false
}

function ReleaseLock()
{
    DeleteFile(IPC_LOCK_FILE)
}

// ============================================
// JSON Handling
// ============================================

function SerializeToJSON(data)
{
    if (json ~= null) {
        return json.encode(data)
    }
    
    -- Fallback: use basic JSON serialization
    Log("WARNING: JSON library not available, using basic serialization")
    return SerializeTable(data)
}

function DeserializeFromJSON(jsonString)
{
    if (json ~= null) {
        local success, result = pcall(function() return json.decode(jsonString) end)
        if (success) {
            return result
        }
    }
    
    Log("WARNING: JSON parsing failed")
    return null
}

// Basic table to JSON serialization (fallback)
function SerializeTable(tbl, indent)
{
    local indent = indent or ""
    local result = "{" .. "\n"
    
    local keys = {}
    for k, _ in pairs(tbl) do
        table.insert(keys, k)
    end
    
    for i, key in ipairs(keys) do
        local value = tbl[key]
        result = result .. indent .. "  \"" .. tostring(key) .. "\": "
        
        if (type(value) == "table") then
            result = result .. SerializeTable(value, indent .. "  ")
        elseif (type(value) == "string") then
            result = result .. "\"" .. string.gsub(value, "\"", "\\\"") .. "\""
        elseif (type(value) == "number") then
            result = result .. tostring(value)
        elseif (type(value) == "boolean") then
            result = result .. (value and "true" or "false")
        else
            result = result .. "null"
        end
        
        if (i < #keys) then
            result = result .. ","
        end
        result = result .. "\n"
    end
    
    return result .. indent .. "}"
}

// ============================================
// State Writing
// ============================================

local lastStateWriteTime = 0

function WriteGameState(state)
{
    -- Use lock to prevent concurrent access
    if (!AcquireLock(0.5)) then
        Log("WARNING: Could not acquire lock for state write")
        return false
    end
    
    local jsonData = SerializeToJSON(state)
    
    if (jsonData == null or jsonData == "") then
        ReleaseLock()
        Log("ERROR: Failed to serialize state to JSON")
        return false
    end
    
    -- Write state to file
    local success = WriteFile(IPC_STATE_FILE, jsonData)
    
    ReleaseLock()
    
    if (success) {
        Log("State written to " .. IPC_STATE_FILE .. " (" .. #jsonData .. " bytes)")
    }
    
    return success
}

function ShouldWriteState()
{
    local currentTime = GetTimestamp()
    local interval = STATE_WRITE_INTERVAL
    
    if (currentTime - lastStateWriteTime >= interval) then
        lastStateWriteTime = currentTime
        return true
    end
    
    return false
}

// ============================================
// Command Reading
// ============================================

local lastCommandReadTime = 0
local lastProcessedCommands = {}

function ReadCommands()
{
    local currentTime = GetTimestamp()
    local interval = COMMAND_READ_INTERVAL
    
    if (currentTime - lastCommandReadTime < interval) then
        return {}
    end
    
    lastCommandReadTime = currentTime
    
    -- Use lock to prevent concurrent access
    if (!AcquireLock(0.5)) then
        Log("WARNING: Could not acquire lock for command read")
        return {}
    end
    
    local content = ReadFile(IPC_COMMAND_FILE)
    
    if (content == null or content == "") then
        ReleaseLock()
        return {}
    end
    
    -- Parse JSON
    local commandsData = DeserializeFromJSON(content)
    
    ReleaseLock()
    
    if (commandsData == null) then
        Log("ERROR: Failed to parse commands JSON")
        -- Clear the file to prevent reprocessing
        DeleteFile(IPC_COMMAND_FILE)
        return {}
    end
    
    -- Extract commands array
    local commands = commandsData.commands or {}
    
    if (#commands == 0) then
        -- No commands, clear the file
        DeleteFile(IPC_COMMAND_FILE)
        return {}
    end
    
    -- Clear the command file after reading
    DeleteFile(IPC_COMMAND_FILE)
    
    return commands
}

function ProcessCommand(command)
{
    if (command == null) {
        return false
    }
    
    local commandType = command.command
    if (commandType == null) {
        Log("WARNING: Command missing 'command' field")
        return false
    }
    
    Log("Processing command: " .. commandType)
    
    -- Route command to appropriate handler
    if (commandType == "BUILD") {
        return HandleBuildCommand(command)
    } elseif (commandType == "CAPTURE") {
        return HandleCaptureCommand(command)
    } elseif (commandType == "ATTACK_MOVE") {
        return HandleAttackMoveCommand(command)
    } elseif (commandType == "SET_POSTURE") {
        return HandleSetPostureCommand(command)
    } elseif (commandType == "PRODUCE") {
        return HandleProduceCommand(command)
    } elseif (commandType == "RETREAT") {
        return HandleRetreatCommand(command)
    } elseif (commandType == "STOP") {
        return HandleStopCommand(command)
    } elseif (commandType == "HOLD") {
        return HandleHoldCommand(command)
    } elseif (commandType == "PING") {
        return HandlePingCommand(command)
    } else {
        Log("WARNING: Unknown command type: " .. commandType)
        return false
    }
}

// ============================================
// Command Handlers
// ============================================

function HandleBuildCommand(command)
{
    local engineerId = command.engineer_id
    local buildingType = command.building_type
    local position = command.position
    
    if (engineerId == null or buildingType == null or position == null) then
        Log("ERROR: BUILD command missing required parameters")
        return false
    end
    
    Log(string.format("BUILD command: engineer=%d, building=%s, pos=(%d,%d,%d)",
        engineerId, buildingType, position[1], position[2], position[3]))
    
    -- Find engineer squad
    local engineer = GetSquadById(engineerId)
    if (engineer == null) then
        Log("ERROR: Engineer squad not found")
        return false
    end
    
    -- Execute build command
    local success = engineer:Build(buildingType, position[1], position[2], position[3])
    
    if (success) then
        Log("BUILD command executed successfully")
    else
        Log("ERROR: BUILD command failed")
    end
    
    return success
}

function HandleCaptureCommand(command)
{
    local squadId = command.squad_id
    local pointId = command.point_id
    
    if (squadId == null or pointId == null) then
        Log("ERROR: CAPTURE command missing required parameters")
        return false
    end
    
    Log(string.format("CAPTURE command: squad=%d, point=%d", squadId, pointId))
    
    -- Find squad
    local squad = GetSquadById(squadId)
    if (squad == null) then
        Log("ERROR: Squad not found for CAPTURE")
        return false
    end
    
    -- Find capture point
    local cp = GetCapturePointById(pointId)
    if (cp == null) then
        Log("ERROR: Capture point not found")
        return false
    end
    
    -- Execute capture command
    local success = squad:Capture(cp)
    
    if (success) then
        Log("CAPTURE command executed successfully")
    else
        Log("ERROR: CAPTURE command failed")
    end
    
    return success
}

