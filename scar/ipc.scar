function HandlePingCommand(command)
{
    Log("PING command received")
    
    -- Send PONG response
    local pongCommand = {
        command = "PONG",
        timestamp = command.timestamp or GetTimestamp()
    }
    
    -- Write pong response
    local response = {
        commands = {pongCommand}
    }
    
    if (!AcquireLock(0.5)) then
        Log("WARNING: Could not acquire lock for PONG response")
        return false
    end
    
    local success = WriteFile(IPC_COMMAND_FILE, SerializeToJSON(response))
    ReleaseLock()
    
    return success
}

// ============================================
// Helper Functions
// ============================================

function GetSquadById(squadId)
{
    local player = GetLocalPlayer()
    if (!IsValidPlayer(player)) then
        return null
    end
    
    local squads = player:GetSquads()
    if (squads == null) then
        return null
    end
    
    for i = 1, #squads do
        local squad = squads[i]
        if (squad:GetId() == squadId) then
            return squad
        end
    end
    
    return null
}

function GetCapturePointById(cpId)
{
    local map = ebx:Game.GetMap()
    if (map == null) then
        return null
    end
    
    local cps = map:GetCapturePoints()
    if (cps == null) then
        return null
    end
    
    for i = 1, #cps do
        local cp = cps[i]
        if (cp:GetId() == cpId) then
            return cp
        end
    end
    
    return null
}

function GetBuildingById(buildingId)
{
    local player = GetLocalPlayer()
    if (!IsValidPlayer(player)) then
        return null
    end
    
    local buildings = player:GetBuildings()
    if (buildings == null) then
        return null
    end
    
    for i = 1, #buildings do
        local building = buildings[i]
        if (building:GetId() == buildingId) then
            return building
        end
    end
    
    return null
}

// ============================================
// Main IPC Update Function
// ============================================

function UpdateIPC(deltaTime)
{
    -- Read and process commands
    local commands = ReadCommands()
    
    if (#commands > 0) then
        for i = 1, #commands do
            ProcessCommand(commands[i])
        end
        return true  -- Commands were processed
    end
    
    -- Write game state if it's time
    if (ShouldWriteState()) then
        local state = CollectGameState()
        if (state ~= null) then
            WriteGameState(state)
            return true  -- State was written
        end
    end
    
    return false
}

// ============================================
// Initialization
// ============================================

function InitializeIPC()
{
    Log("Initializing IPC system")
    
    -- Ensure data directory exists
    EnsureDirectoryExists(DATA_DIR)
    
    -- Test state collection
    local testState = CollectGameState()
    if (testState == null) then
        Log("ERROR: Failed to collect initial state")
        return false
    end
    
    -- Test state writing
    local success = WriteGameState(testState)
    if (!success) then
        Log("ERROR: Failed to write initial state")
        return false
    end
    
    Log("IPC system initialized successfully")
    return true
}
