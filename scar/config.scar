// ============================================
// Utility Functions
// ============================================

function GetModVersion()
{
    return MOD_VERSION
}

function GetModName()
{
    return MOD_NAME
}

function IsDebugEnabled()
{
    return DEBUG_ENABLED
}

function GetDebugLevel()
{
    return DEBUG_LEVEL
}

function ShouldLog(level)
{
    return DEBUG_ENABLED && level <= DEBUG_LEVEL
}

