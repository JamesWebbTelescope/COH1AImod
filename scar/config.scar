// ============================================
// Configuration Validation
// ============================================

function ValidateConfiguration()
{
    Log("Validating configuration")
    
    // Check critical settings
    if (!IsValidFaction(DEFAULT_FACTION)) {
        Log("ERROR: Invalid default faction")
        return false
    }
    
    if (!IsValidDifficulty(DEFAULT_DIFFICULTY)) {
        Log("ERROR: Invalid default difficulty")
        return false
    }
    
    return true
}

function IsValidFaction(faction)
{
    return faction == FACTION_ALLIES || faction == FACTION_AXIS
}

function IsValidDifficulty(difficulty)
{
    return difficulty == DIFFICULTY_EASY ||
           difficulty == DIFFICULTY_NORMAL ||
           difficulty == DIFFICULTY_HARD ||
           difficulty == DIFFICULTY_EXPERT
}

// ============================================
// Default Configuration
// ============================================

function GetDefaultConfiguration()
{
    return {
        "mod": {
            "version": MOD_VERSION,
            "name": MOD_NAME
        },
        "ipc": {
            "state_file": IPC_STATE_FILE,
            "command_file": IPC_COMMAND_FILE,
            "poll_interval": IPC_POLL_INTERVAL,
            "max_retries": MAX_RETRIES
        },
        "game": {
            "faction": DEFAULT_FACTION,
            "difficulty": DEFAULT_DIFFICULTY
        },
        "mistral": {
            "api_url": MISTRAL_API_URL,
            "model": DEFAULT_MODEL,
            "max_calls": MAX_API_CALLS_PER_MATCH,
            "api_key": "YOUR_API_KEY_HERE"
        },
        "reflex": {
            "retreat_threshold": RETREAT_HEALTH_THRESHOLD,
            "critical_threshold": CRITICAL_HEALTH_THRESHOLD,
            "build_queue_min": BUILD_QUEUE_MIN_SIZE,
            "build_queue_max": BUILD_QUEUE_MAX_SIZE
        },
        "debug": {
            "enabled": DEBUG_ENABLED,
            "level": DEBUG_LEVEL,
            "file_logging": DEBUG_FILE_LOGGING,
            "console_logging": DEBUG_CONSOLE_LOGGING
        }
    }
}

// ============================================
// Initialization
// ============================================

function InitializeConfiguration()
{
    Log("Initializing configuration")
    
    // Load or create default configuration
    if (!LoadConfiguration()) {
        Log("No configuration file found, using defaults")
        // Configuration will use defaults defined above
    }
    
    // Validate configuration
    if (!ValidateConfiguration()) {
        Log("ERROR: Configuration validation failed")
        return false
    }
    
    Log("Configuration initialized successfully")
    return true
}
