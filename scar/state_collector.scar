// ============================================
// Game State Data Structure
// ============================================

// Main game state object structure:
// {
//   "version": "string",
//   "player_id": "integer",
//   "timestamp": "float",
//   "game_time": "float",
//   "game_phase": "string",  // "early", "mid", "late"
//   "resources": {
//     "manpower": {"current": 0, "income": 0, "max": 0},
//     "fuel": {"current": 0, "income": 0, "max": 0},
//     "munitions": {"current": 0, "income": 0, "max": 0}
//   },
//   "squads": [
//     {
//       "id": "integer",
//       "type": "string",
//       "health": "float",  // 0.0 - 1.0
//       "max_health": "float",
//       "vet_level": "integer",  // 0-5
//       "position": {"x": "float", "y": "float", "z": "float"},
//       "posture": "string",  // "aggressive", "defensive", "retreat", "hold"
//       "target": "integer or null",
//       "in_combat": "boolean",
//       "under_fire": "boolean",
//       "suppressed": "boolean",
//       "pinned": "boolean"
//     }
//   ],
//   "capture_points": [
//     {
//       "id": "integer",
//       "position": {"x": "float", "y": "float", "z": "float"},
//       "owner": "integer or null",  // player_id or null
//       "capture_progress": "float",  // 0.0 - 1.0
//       "is_neutral": "boolean"
//     }
//   ],
//   "visible_enemies": [
//     {
//       "id": "integer",
//       "type": "string",
//       "health": "float",
//       "position": {"x": "float", "y": "float", "z": "float"},
//       "posture": "string",
//       "distance": "float",
//       "in_combat": "boolean"
//     }
//   ],
//   "tech_tree": {
//     "tier_1": "boolean",  // unlocked
//     "tier_2": "boolean",
//     "tier_3": "boolean",
//     "t1_progress": "float",  // 0.0 - 1.0
//     "t2_progress": "float",
//     "t3_progress": "float",
//     "abilities": ["string"]
//   },
//   "build_queue": [
//     {
//       "type": "string",  // "unit", "building", "ability"
//       "name": "string",
//       "progress": "float",  // 0.0 - 1.0
//       "time": "float",  // estimated time remaining
//       "cost": [manpower, fuel, munitions]
//     }
//   ],
//   "pop": [current, max],
//   "faction": "string"  // "allies" or "axis"
// }

// ============================================
// Global References
// ============================================

// Cache the local player reference for performance
local localPlayer = null

// ============================================
// Utility Functions
// ============================================

function GetLocalPlayer()
{
    if (localPlayer == null) {
        localPlayer = ebx:Game.GetLocalPlayer()
    }
    return localPlayer
}

function IsValidPlayer(player)
{
    return player != null && player:IsValid()
}

function SafeCall(func, defaultValue)
{
    if (func == null) return defaultValue
    
    local success, result = pcall(func)
    if (success) {
        return result
    } else {
        Log("WARNING: SafeCall failed: " .. tostring(result))
        return defaultValue
    }
}

function GetTimestamp()
{
    return ebx:Game.GetGameTime()
}

// ============================================
// Resource Collection
// ============================================

function CollectResources()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect resources - invalid local player")
        return {
            "manpower": {"current": 0, "income": 0, "max": 1000},
            "fuel": {"current": 0, "income": 0, "max": 800},
            "munitions": {"current": 0, "income": 0, "max": 600}
        }
    }
    
    local resources = {}
    
    // Get manpower
    local mp = player:GetManpower()
    resources.manpower = {
        current = mp:GetCurrent(),
        income = mp:GetIncome(),
        max = mp:GetMax()
    }
    
    // Get fuel
    local fuel = player:GetFuel()
    resources.fuel = {
        current = fuel:GetCurrent(),
        income = fuel:GetIncome(),
        max = fuel:GetMax()
    }
    
    // Get munitions
    local muni = player:GetMunitions()
    resources.munitions = {
        current = muni:GetCurrent(),
        income = muni:GetIncome(),
        max = muni:GetMax()
    }
    
    return resources
}

// ============================================
// Squad Collection
// ============================================

// Squad type mapping from internal names to standardized names
local squadTypeMap = {
    -- Allies
    ["soldier_rifle"] = "riflemen",
    ["soldier_engineer"] = "engineer",
    ["soldier_sniper"] = "sniper",
    ["soldier_mg"] = "machine_gun",
    ["soldier_mortar"] = "mortar",
    ["soldier_bazooka"] = "bazooka",
    ["soldier_grenadier"] = "grenadier",
    ["vehicle_jeep"] = "scout_car",
    ["vehicle_halftrack"] = "halftrack",
    ["vehicle_light_tank"] = "light_tank",
    ["vehicle_medium_tank"] = "medium_tank",
    ["vehicle_heavy_tank"] = "heavy_tank",
    -- Axis (similar mapping)
    ["soldier_volks"] = "riflemen",
    ["soldier_pioneer"] = "engineer",
    ["soldier_sniper_axis"] = "sniper",
    ["soldier_hmg"] = "machine_gun",
    ["soldier_mortar_axis"] = "mortar",
    ["soldier_panzerschreck"] = "bazooka",
    ["soldier_grenadier_axis"] = "grenadier"
}

function GetStandardSquadType(squad)
{
    local internalType = squad:GetType()
    local standardType = squadTypeMap[internalType]
    
    if (standardType == null) {
        // Return the internal type as fallback
        return internalType or "unknown"
    }
    return standardType
}

function GetSquadPosture(squad)
{
    local posture = squad:GetPosture()
    if (posture == "aggressive") return "aggressive"
    if (posture == "defensive") return "defensive"
    if (posture == "retreat") return "retreat"
    return "hold"
}

function CollectSquadData(squad)
{
    if (squad == null || !squad:IsValid()) {
        return null
    }
    
    local squadData = {}
    
    squadData.id = squad:GetId()
    squadData.type = GetStandardSquadType(squad)
    
    // Health information
    local health = squad:GetHealth()
    squadData.health = health.current or 0
    squadData.max_health = health.max or 1
    
    // If health is 0, avoid division by zero
    if (squadData.max_health <= 0) {
        squadData.max_health = 1
    }
    
    // Vet level
    squadData.vet_level = squad:GetVeterancy() or 0
    
    // Position
    local pos = squad:GetPosition()
    if (pos ~= null) {
        squadData.pos = {pos.x, pos.y, pos.z}
    } else {
        squadData.pos = {0, 0, 0}
    }
    
    // Posture
    squadData.posture = GetSquadPosture(squad)
    
    // Target
    local target = squad:GetTarget()
    squadData.target = (target ~= null) and target:GetId() or null
    
    // Combat status
    squadData.in_combat = squad:InCombat() or false
    squadData.under_fire = squad:UnderFire() or false
    squadData.suppressed = squad:IsSuppressed() or false
    squadData.pinned = squad:IsPinned() or false
    
    return squadData
}

function CollectSquads()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect squads - invalid local player")
        return {}
    }
    
    local squads = player:GetSquads()
    local squadList = {}
    
    if (squads ~= null) {
        for i = 1, #squads do
            local squad = squads[i]
            local squadData = CollectSquadData(squad)
            if (squadData ~= null) {
                table.insert(squadList, squadData)
            }
        end
    }
    
    return squadList
}

// ============================================
// Capture Point Collection
// ============================================

function CollectCapturePointData(cp)
{
    if (cp == null || !cp:IsValid()) {
        return null
    }
    
    local cpData = {}
    cpData.id = cp:GetId()
    
    local pos = cp:GetPosition()
    if (pos ~= null) {
        cpData.pos = {pos.x, pos.y, pos.z}
    } else {
        cpData.pos = {0, 0, 0}
    }
    
    // Owner (can be null if neutral or contested)
    local owner = cp:GetOwner()
    cpData.owner = (owner ~= null) and owner:GetId() or null
    
    // Capture progress
    cpData.capture_progress = cp:GetCaptureProgress() or 0
    
    // Neutral status
    cpData.is_neutral = (cpData.owner == null)
    
    return cpData
}

function CollectCapturePoints()
{
    local map = ebx:Game.GetMap()
    if (map == null) {
        Log("ERROR: Cannot get map for capture points")
        return {}
    }
    
    local cps = map:GetCapturePoints()
    local cpList = {}
    
    if (cps ~= null) {
        for i = 1, #cps do
            local cp = cps[i]
            local cpData = CollectCapturePointData(cp)
            if (cpData ~= null) {
                table.insert(cpList, cpData)
            }
        end
    }
    
    return cpList
}

// ============================================
// Enemy Unit Collection
// ============================================

function CollectEnemyData(enemySquad)
{
    if (enemySquad == null || !enemySquad:IsValid()) {
        return null
    }
    
    local player = GetLocalPlayer()
    if (!IsValidPlayer(player)) {
        return null
    }
    
    local enemyData = {}
    
    enemyData.id = enemySquad:GetId()
    enemyData.type = GetStandardSquadType(enemySquad)
    
    // Health
    local health = enemySquad:GetHealth()
    enemyData.health = (health.current or 0) / (health.max or 1)
    
    // Position
    local pos = enemySquad:GetPosition()
    if (pos ~= null) {
        enemyData.pos = {pos.x, pos.y, pos.z}
        
        // Calculate distance from player's average position
        local playerPos = player:GetAveragePosition()
        if (playerPos ~= null) {
            local dx = pos.x - playerPos.x
            local dy = pos.y - playerPos.y
            local dz = pos.z - playerPos.z
            enemyData.distance = math.sqrt(dx*dx + dy*dy + dz*dz)
        } else {
            enemyData.distance = 0
        }
    } else {
        enemyData.pos = {0, 0, 0}
        enemyData.distance = 0
    }
    
    enemyData.posture = GetSquadPosture(enemySquad)
    enemyData.in_combat = enemySquad:InCombat() or false
    
    return enemyData
}

function CollectVisibleEnemies()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect visible enemies - invalid local player")
        return {}
    }
    
    local enemies = player:GetVisibleEnemies()
    local enemyList = {}
    
    if (enemies ~= null) {
        for i = 1, #enemies do
            local enemy = enemies[i]
            local enemyData = CollectEnemyData(enemy)
            if (enemyData ~= null) {
                table.insert(enemyList, enemyData)
            }
        end
    }
    
    return enemyList
}

// ============================================
// Tech Tree Collection
// ============================================

function CollectTechTree()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect tech tree - invalid local player")
        return {
            tier_1 = false,
            tier_2 = false,
            tier_3 = false,
            abilities = {},
            t1_progress = 0,
            t2_progress = 0,
            t3_progress = 0
        }
    }
    
    local techTree = player:GetTechTree()
    local techData = {}
    
    if (techTree ~= null) {
        techData.tier_1 = SafeCall(function() return techTree:IsTier1Unlocked() end, false)
        techData.tier_2 = SafeCall(function() return techTree:IsTier2Unlocked() end, false)
        techData.tier_3 = SafeCall(function() return techTree:IsTier3Unlocked() end, false)
        
        techData.t1_progress = SafeCall(function() return techTree:GetTier1Progress() end, 0)
        techData.t2_progress = SafeCall(function() return techTree:GetTier2Progress() end, 0)
        techData.t3_progress = SafeCall(function() return techTree:GetTier3Progress() end, 0)
        
        // Collect abilities
        techData.abilities = {}
        local abilities = SafeCall(function() return techTree:GetAbilities() end, {})
        if (abilities ~= null) {
            for i = 1, #abilities do
                local ability = abilities[i]
                if (ability ~= null) {
                    table.insert(techData.abilities, ability:GetName() or "unknown")
                }
            end
        }
    } else {
        // Fallback to default values
        techData.tier_1 = false
        techData.tier_2 = false
        techData.tier_3 = false
        techData.t1_progress = 0
        techData.t2_progress = 0
        techData.t3_progress = 0
        techData.abilities = {}
    }
    
    return techData
}

// ============================================
// Build Queue Collection
// ============================================

function CollectBuildQueueItem(queueItem)
{
    if (queueItem == null) {
        return null
    }
    
    local itemData = {}
    
    // Item type
    local itemType = queueItem:GetType()
    if (itemType == "unit") {
        itemData.type = "unit"
    } elseif (itemType == "building") {
        itemData.type = "building"
    } elseif (itemType == "ability") {
        itemData.type = "ability"
    } else {
        itemData.type = "unknown"
    }
    
    itemData.name = queueItem:GetName() or "unknown"
    itemData.progress = queueItem:GetProgress() or 0
    itemData.time = queueItem:GetTimeRemaining() or 0
    
    // Cost
    local cost = queueItem:GetCost()
    if (cost ~= null) {
        itemData.cost = {
            cost.manpower or 0,
            cost.fuel or 0,
            cost.munitions or 0
        }
    } else {
        itemData.cost = {0, 0, 0}
    }
    
    return itemData
}

function CollectBuildQueue()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect build queue - invalid local player")
        return {}
    }
    
    local queue = player:GetBuildQueue()
    local queueList = {}
    
    if (queue ~= null) {
        for i = 1, #queue do
            local item = queue[i]
            local itemData = CollectBuildQueueItem(item)
            if (itemData ~= null) {
                table.insert(queueList, itemData)
            }
        end
    }
    
    return queueList
}

// ============================================
// Population Collection
// ============================================

function CollectPopulation()
{
    local player = GetLocalPlayer()
    
    if (!IsValidPlayer(player)) {
        Log("ERROR: Cannot collect population - invalid local player")
        return {0, 100}  // current, max
    }
    
    local pop = player:GetPopulation()
    if (pop ~= null) {
        return {pop.current or 0, pop.max or 100}
    } else {
        return {0, 100}
    }
}

// ============================================
// Game Time and Phase
// ============================================

function CollectGameTime()
{
    return SafeCall(function() return ebx:Game.GetGameTime() end, 0)
}

function DetermineGamePhase(gameTime)
{
    if (gameTime < 300) {  // First 5 minutes
        return "early"
    } elseif (gameTime < 900) {  // Next 10 minutes
        return "mid"
    } else {
        return "late"
    }
}

// ============================================
// Faction Detection
// ============================================

function GetFaction()
{
    local player = GetLocalPlayer()
    
    if (IsValidPlayer(player)) {
        local faction = player:GetFaction()
        if (faction ~= null) {
            return string.lower(faction:GetName() or "allies")
        }
    }
    
    return "allies"  // Default
}

// ============================================
// Main State Collection Function
// ============================================

function CollectGameState()
{
    local state = {}
    
    // Add metadata
    state.version = "1.0"
    state.player = GetLocalPlayer():GetId() or 1
    state.time = GetTimestamp()
    
    // Collect all data
    state.resources = CollectResources()
    state.squads = CollectSquads()
    state.cps = CollectCapturePoints()
    state.enemies = CollectVisibleEnemies()
    state.tech = CollectTechTree()
    state.queue = CollectBuildQueue()
    state.pop = CollectPopulation()
    state.game_time = CollectGameTime()
    state.phase = DetermineGamePhase(state.game_time)
    state.faction = GetFaction()
    
    // Filter out invalid data
    state = FilterInvalidData(state)
    
    return state
}

// ============================================
// JSON Serialization for IPC
// ============================================

function SerializeGameState(state)
{
    -- Use the serializer module if available
    if (SerializeToJSON ~= nil) then
        return SerializeToJSON(state)
    end
    
    // Fallback: Use SCAR's JSON encoder if available
    if (json ~= null) {
        return json.encode(state)
    }
    
    // Final fallback: simple serialization
    Log("WARNING: JSON encoder not available, using basic serialization")
    return "{}"  // Placeholder - in practice, use a proper JSON library
}

// ============================================
// Data Validation and Filtering
// ============================================

function FilterInvalidData(state)
{
    if (state == null) {
        return {}
    }
    
    // Validate and sanitize each component
    if (state.resources == null) {
        state.resources = {
            manpower = {current = 0, income = 0, max = 1000},
            fuel = {current = 0, income = 0, max = 800},
            munitions = {current = 0, income = 0, max = 600}
        }
    }
    
    if (state.squads == null) {
        state.squads = {}
    }
    
    if (state.cps == null) {
        state.cps = {}
    }
    
    if (state.enemies == null) {
        state.enemies = {}
    }
    
    if (state.tech == null) {
        state.tech = {tier_1 = false, tier_2 = false, tier_3 = false, abilities = {}, t1_progress = 0, t2_progress = 0, t3_progress = 0}
    }
    
    if (state.queue == null) {
        state.queue = {}
    }
    
    if (state.pop == null) {
        state.pop = {0, 100}
    }
    
    if (state.game_time == null) {
        state.game_time = 0
    }
    
    if (state.phase == null) {
        state.phase = "early"
    }
    
    if (state.faction == null) {
        state.faction = "allies"
    }
    
    return state
}

// ============================================
// Performance Optimization
// ============================================

// Cache for expensive operations
local stateCache = null
local lastCollectionTime = 0

function GetCachedState(maxAge)
{
    local currentTime = GetTimestamp()
    
    if (stateCache ~= null && (currentTime - lastCollectionTime) < (maxAge or 1.0)) {
        return stateCache
    }
    
    stateCache = CollectGameState()
    lastCollectionTime = currentTime
    return stateCache
}

// ============================================
// Delta State Collection (for performance)
// ============================================

function CollectDeltaState()
{
    // For now, collect full state
    // In future, implement incremental updates
    return CollectGameState()
}

// ============================================
// Initialization
// ============================================

function InitializeStateCollector()
{
    Log("Initializing state collector")
    
    // Test data collection
    local testState = CollectGameState()
    
    if (testState == null || testState == {}) {
        Log("WARNING: State collection returned empty data")
        return false
    }
    
    Log("State collector initialized successfully")
    return true
}

// ============================================
// Periodic State Collection
// ============================================

local collectionInterval = 1.0  // Seconds between collections
local lastCollectionTick = 0

function UpdateStateCollector(deltaTime)
{
    lastCollectionTick = lastCollectionTick + deltaTime
    
    if (lastCollectionTick >= collectionInterval) {
        lastCollectionTick = 0
        local state = CollectGameState()
        
        // In a real implementation, this would write to IPC file
        // For now, just collect and validate
        if (state ~= null) {
            // Log summary
            Log(string.format("State collected: %d squads, %d CPs, %d enemies",
                #state.squads, #state.cps, #state.enemies))
        }
        
        return state
    }
    
    return null
}
